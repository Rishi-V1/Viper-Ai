# Copy this file to .env and adjust as needed.

# SQLite database file path (relative to project root)
DATABASE_PATH=./data/blueshield.db

# Enable/disable the Ollama local LLM integration.
# The app must work fully with LLM_ENABLED=false (no-LLM mode).
# Once you've pulled real model tags below, flip this to true, or just
# toggle "Enable LLM-assisted analysis" on the dashboard's Settings page
# (takes effect immediately, no restart).
LLM_ENABLED=false

# Ollama HTTP API, must stay bound to localhost
OLLAMA_BASE_URL=http://localhost:11434

# Exact installed model tags (verify with `ollama list` before enabling)
OLLAMA_MODEL_PRIMARY=qwen2.5-coder:7b
OLLAMA_MODEL_SECONDARY=deepseek-r1:7b

# Request timeout for LLM calls, seconds. 7b models on CPU can take a while
# for the first response - raise this if you see "timeout" validation statuses.
OLLAMA_TIMEOUT_SECONDS=120

# Correlation engine defaults
CORRELATION_TIME_WINDOW_MINUTES=10

# Max gap (seconds) between identical sensor alerts to treat as one duplicate
# cluster. Only applies to sensor-type sources (e.g. suricata), never to
# auth-log events, since each login attempt is a distinct real occurrence.
DEDUP_WINDOW_SECONDS=30

# Risk scoring thresholds (0-100 scale)
RISK_THRESHOLD_LOW=25
RISK_THRESHOLD_HIGH=50
RISK_THRESHOLD_CRITICAL=75

# Upload limits
MAX_UPLOAD_SIZE_MB=10
